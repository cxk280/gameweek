# Serves the Godot HTML5 export as static files on Railway's $PORT.
# Single-threaded export needs no COOP/COEP headers (see docs/DECISIONS.md D4).
:{$PORT:8080}
root * /usr/share/caddy
# The export assets (index.pck/wasm/js) are referenced by plain filename with no
# version hash, so a redeploy reuses the same URLs. Without an explicit directive,
# browsers cache them heuristically and can keep serving a stale build after a deploy.
# "no-cache" = store but always revalidate via ETag (304 when unchanged, cheap), so a
# new export is picked up on the next load instead of being masked by the old cache.
header Cache-Control "no-cache"
file_server
encode gzip
